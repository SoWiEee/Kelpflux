# 2×1 heavy-tail live A/B image — bakes the 166-dim (obs_dim=166, n_actions=33)
# σ=1.0 checkpoints from runs/stoch_sweep_2x1_20260618-003742/ so the served
# model MATCHES the live 2-node cluster's obs, and serve.py /reload can swap
# among the three arms (all 166-dim → dim-guard passes).
#
# Boot model = RDSAC-cvar σ=1.0 (so /healthz reports obs_dim=166 and /decide
# stops abstaining). The three arms live under /models/htab/ for run_heavytail_ab.
#
# Build (context = repo root):
#   docker build -t slurm-rl-scheduler:htab2x1 \
#     -f services/rl_scheduler/Dockerfile.htab2x1 .
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY services/rl_scheduler/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY sim /app/sim
COPY services/rl_scheduler /app/services/rl_scheduler
COPY services/__init__.py /app/services/__init__.py

# 166-dim boot model + the three 2×1 σ=1.0 arms for /reload.
COPY runs/stoch_sweep_2x1_20260618-003742/ckpt_rdsac-cvar_sigma1.0.pt /models/dsac.pt
COPY runs/stoch_sweep_2x1_20260618-003742/ckpt_sac_sigma1.0.pt        /models/htab/sac.pt
COPY runs/stoch_sweep_2x1_20260618-003742/ckpt_rdsac-mean_sigma1.0.pt /models/htab/rdsac_mean.pt
COPY runs/stoch_sweep_2x1_20260618-003742/ckpt_rdsac-cvar_sigma1.0.pt /models/htab/rdsac_cvar.pt

ENV PYTHONPATH=/app \
    LOG_LEVEL=INFO \
    SHADOW_MODE=true \
    SNAPSHOT_TTL_S=30 \
    PRIORITY_BOOST=1000

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8002/healthz || exit 1

CMD ["python", "-m", "services.rl_scheduler.serve", \
     "--policy-dir", "/models", "--port", "8002", "--host", "0.0.0.0"]
